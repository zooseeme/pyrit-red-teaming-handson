# Copy this file to .env and fill in the temporary values from your instructor.
#
# Azure OpenAI v1-compatible endpoint example:
# OPENAI_CHAT_ENDPOINT="https://YOUR_RESOURCE.openai.azure.com/openai/v1"
#
# Other OpenAI-compatible endpoints may also work if they support chat completions.

OPENAI_CHAT_ENDPOINT="https://YOUR_RESOURCE.openai.azure.com/openai/v1"
OPENAI_CHAT_KEY="YOUR_TEMPORARY_KEY"
OPENAI_CHAT_MODEL="YOUR_MODEL_OR_DEPLOYMENT"

# Optional: used by the toy guardrail exercises.
HANDSON_SECRET_PHRASE="TRAINING-ONLY-42"

